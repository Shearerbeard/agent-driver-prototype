+        ancestor,
+    );
+    ancestor_task.worker = Some("analyst".to_owned());
+    plan.add_task(ancestor_task);
+    plan.add_task(Task::new(1, target_description, "fixture target").with_dependency(0));
+    FrameGraph::new(plan, 1).expect("direct frame renders")
+}
