+        for (variant, expected_str) in &variants {
+            let json = serde_json::to_string(variant).unwrap();
+            assert_eq!(
+                json,
+                format!("\"{}\"", expected_str),
+                "serde mismatch for {:?}",
+                variant
+            );
+            let deserialized: FailureCategory = serde_json::from_str(&json).unwrap();
+            assert_eq!(&deserialized, variant);
+        }
+    }
