+    use crate::persistence::{ToolOutcome, ToolTraceEntry};
+
+    fn make_trace(
+        tool: &str,
+        reasoning: &str,
+        duration_ms: u64,
+        error: Option<&str>,
+    ) -> ToolTraceEntry {
+        ToolTraceEntry {
+            tool: tool.to_string(),
+            reasoning: reasoning.to_string(),
+            duration_ms,
+            outcome: match error {
+                Some(msg) => ToolOutcome::Error {
+                    message: msg.to_string(),
+                },
+                None => ToolOutcome::Success { output_bytes: 1024 },
+            },
+            artifact_filename: None,
+        }
+    }
