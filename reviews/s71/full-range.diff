+    assert_eq!(runs.plan_ids(), vec![PlanId::derive(&plan_args())]);
+    assert_eq!(outcome.turns(), 2);
+    assert!(matches!(
+        outcome,
+        CoordinatorOutcome::StoppedWithoutResponse { .. }
+    ));
